    },
    {
      "name": "POST ask without auth returns 401",
      "method": "POST",
      "path": "/",
      "body": {"action": "ask", "dialog_id": "00000000-0000-0000-0000-000000000000", "question": "test", "cards": ["Shut"]},
      "expectedStatus": 401
    }
  ]
}
